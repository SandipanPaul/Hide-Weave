// Hide & Weave — commission agent management app.
//
// Portability note: this schema targets SQLite for local dev but is written so
// that moving to Postgres is a connection-string change only:
//   * No SQLite-specific types are used.
//   * Status columns are `String`, not Prisma enums (SQLite has no enum support,
//     so using them would force a schema rewrite on migration). Zod owns the
//     allowed values — see src/lib/enums.ts.
//   * Money is `BigInt` (64-bit on SQLite, int8 on Postgres) so order values
//     have no practical ceiling.
//   * Uniqueness (Client.name, Project.orderId, Supplier.website) is enforced in
//     server actions scoped to `deletedAt: null`, not by DB constraints — a soft
//     deleted row must not permanently reserve a name.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id            String  @id @default(cuid())
  /// Short human-readable reference, e.g. "HW-0007", for quoting in emails and
  /// invoices. The cuid `id` is what the database joins on; this is what a
  /// person types and reads.
  ///
  /// Nullable so the column could be added without rebuilding a table half the
  /// schema points at. Every row has one — they were backfilled, and every
  /// write sets it — and the unique index means a blank can never be
  /// duplicated into a second row.
  code          String? @unique
  name          String
  address       String?
  /// ISO 3166-1 alpha-2 code, e.g. "IN". Names are derived for display, so the
  /// same country typed several ways still groups as one.
  country       String?
  website       String?
  contactPerson String?
  status        String  @default("ACTIVE")

  /// Fixed monthly retainer in minor units (paise for INR). Independent of
  /// per-order commission.
  fixedMonthly BigInt?
  /// Currency of `fixedMonthly`. Per-order currency lives on Project.
  currency     String  @default("INR")

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  samplings ClientSampling[]
  projects  Project[]
  /// Retainer fees this client has paid, logged by hand from their page.
  retainers RetainerReceipt[]
  /// Spends made for this client with no order behind them — a sample sent to
  /// a prospect, a trip to visit them.
  expenses  Expense[]
  /// Phone numbers and email addresses, ordered. The first of each kind is
  /// treated as the primary one for lists and sorting.
  contacts  ClientContact[]
  /// Bulk mailings this client was written to. Survives their deletion — see
  /// CampaignRecipient.
  mailings  CampaignRecipient[]

  @@index([deletedAt])
  @@index([name])
  @@index([status])
  @@index([country])
}

model ClientContact {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// "PHONE" or "EMAIL" — see src/lib/enums.ts.
  kind     String
  value    String
  /// Order within its kind, so the client's own preference is preserved.
  position Int    @default(0)

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([kind])
  @@index([value])
  @@index([deletedAt])
}

model ClientSampling {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  product       String?
  status        String   @default("SCHEDULED")

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([deletedAt])
  @@index([scheduledDate])
  @@index([status])
}

/// Someone we source from: a tannery, an exporter, an OEM factory, a private
/// label maker — often several of those at once, which is why `types` is a
/// list rather than a single value. Many Indian leather companies tan hides
/// and export finished goods, and forcing a choice between the two would make
/// the record wrong.
model Supplier {
  id            String  @id @default(cuid())
  companyName   String
  /// Comma-separated values from SUPPLIER_TYPES in src/lib/enums.ts, e.g.
  /// "TANNERY,EXPORTER". Empty when nobody has said yet — an unclassified
  /// supplier is still a real supplier.
  types         String  @default("")
  website       String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  /// Set when the record was created or refreshed via website extraction.
  sourceUrl     String?

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  allocations ProjectSupplier[]

  @@index([deletedAt])
  @@index([companyName])
  @@index([types])
}

/// One supplier's share of one project.
///
/// A 5,00,000-piece order might be split 2,00,000 / 2,00,000 / 1,00,000 across
/// three suppliers. The shares may add up to less than the project's total
/// quantity — work that has not been placed yet — but never to more.
model ProjectSupplier {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Pieces (or whatever the project's unit is) this supplier is making.
  quantity Int
  /// Order within the project, so the split reads the way it was entered.
  position Int @default(0)

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([supplierId])
  @@index([deletedAt])
}

model Project {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Which suppliers are making this order, and how much each is making.
  /// A project may be split across several — see ProjectSupplier.
  suppliers ProjectSupplier[]

  product String
  /// The agent's own reference for this order, issued by the app — see
  /// ORDER_CODES in src/lib/codes.ts. Never typed.
  orderId String
  /// The client's reference for the same order: their PO number, in their
  /// format. It is what arrives in their emails, so it is searchable — but it
  /// is theirs, so it is never generated, validated or required.
  clientReference String?
  quantity Int
  unit     String @default("pcs")

  /// Total consignment value in minor units. This is goods routed through the
  /// agent — it is NOT income. Income is the commission computed from it.
  orderValue           BigInt
  /// Percentage of orderValue earned as commission. The commission amount is
  /// always computed (see src/lib/money.ts), never stored.
  commissionPercentage Float
  currency             String @default("INR")

  status           String    @default("QUOTED")
  orderDate        DateTime
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  payments Payment[]
  expenses Expense[]

  @@index([clientId])
  @@index([deletedAt])
  @@index([orderId])
  @@index([status])
  @@index([orderDate])
  @@index([currency])
}

/// Commission received against one order.
///
/// Payments settle the agent's commission, never the order value. A retainer
/// fee is not one of these — see RetainerReceipt.
model Payment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Amount in minor units, in the parent project's currency, which is copied
  /// here so a payment can be filtered by currency without a join.
  amount   BigInt
  currency String   @default("INR")
  paidOn   DateTime
  method   String?

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([deletedAt])
  @@index([paidOn])
  @@index([currency])
}

/// Money the agent spent, as opposed to money they earned.
///
/// Attached to a project when it was spent on that order (courier for a
/// sample, a factory visit); attached to nothing when it is general overhead
/// the business carries. Both kinds are expenses and both are deducted from
/// earnings — `projectId` only records what the spend was *for*.
///
/// Expenses never touch commission or outstanding: what a client owes is
/// unaffected by what it cost the agent to serve them. They are deducted from
/// earnings, not from receivables.
model Expense {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Who the spend was for, when there is no order to hang it on — a sample
  /// posted to a prospect, a trip to visit someone who has not ordered yet.
  /// Independent of `projectId`: an expense may have both, either or neither.
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Amount in minor units. Held in the parent project's currency when there
  /// is one, so an expense can never be denominated differently from the order
  /// it belongs to.
  amount     BigInt
  currency   String   @default("INR")
  incurredOn DateTime
  /// Free text, offered as a list — see EXPENSE_CATEGORIES in src/lib/enums.ts.
  category   String?
  /// What it was, in the user's own words. The category groups; this explains.
  description String

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([incurredOn])
  @@index([currency])
}




/// One retainer fee, received.
///
/// Deliberately a record of a payment rather than a schedule: the fee is only
/// income once the client has actually paid it, and the person who knows that
/// is the agent. `Client.fixedMonthly` is the rate; each of these is one
/// instance of it arriving, logged with a button on the client's page.
///
/// `amount` is captured at the moment it is logged, so changing a client's
/// rate later never rewrites what was already received.
model RetainerReceipt {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  amount   BigInt
  currency String
  paidOn   DateTime

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([deletedAt])
  @@index([paidOn])
  @@index([currency])
}

/// One bulk mailing: a subject, a body, and the clients it went to.
///
/// The body is stored as it was typed, placeholders and all — `<name>` is
/// substituted per recipient at send time, not before. Keeping the template
/// rather than the expanded copies means the campaign still reads as one
/// message, and the per-recipient text can always be re-derived.
model Campaign {
  id      String @id @default(cuid())
  subject String
  body    String

  /// Addresses copied on every message, separated by commas. Visible to the
  /// recipient, as a CC is. Null when nobody was copied.
  ///
  /// Stored as typed rather than as rows: this is one line of the message
  /// header, the same for every copy, not a list of people the campaign is
  /// tracking delivery to.
  cc String?

  /// "QUEUED" | "SENDING" | "COMPLETED" — see src/lib/enums.ts.
  status String @default("QUEUED")

  /// When the last recipient stopped being PENDING. Null while work remains.
  finishedAt DateTime?

  /// A failure that belongs to the campaign rather than to any one recipient —
  /// wrong credentials, a dropped connection. When this is set the run stopped
  /// early and the untouched recipients are still PENDING, waiting to resume.
  error String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recipients  CampaignRecipient[]
  attachments CampaignAttachment[]

  @@index([deletedAt])
  @@index([createdAt])
  @@index([status])
}

/// A file sent with every copy of one mailing.
///
/// This is the *record* of the file — its name, type and size. The bytes live
/// on disk, in a file named by this row's `id`, because putting them here would
/// copy every attached megabyte into all fourteen retained backups. See
/// src/lib/mail/attachment-store.ts.
///
/// Kept after sending, so a campaign can be resumed, retried, and read back
/// with the files it actually carried.
model CampaignAttachment {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// The name the recipient sees. Taken from the upload, never generated.
  filename    String
  /// MIME type, so the recipient's mail client knows what it has.
  contentType String
  size        Int

  /// Order the files were chosen in, so they arrive in that order.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([campaignId])
}

/// One client's copy of one campaign.
///
/// The client's name and address are copied here rather than joined: mail that
/// has left the building is a historical record, so deleting or renaming a
/// client must not rewrite who was written to, or where. `clientId` is only a
/// link back to the current record, and goes null if that record is removed.
model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// The address written to, as it stood when the campaign was queued.
  email String
  /// What `<name>` was replaced with — the contact person's first name, or the
  /// company name when there is no contact person.
  greeting String
  /// The client's name at send time, for reading the log back.
  clientName String

  /// "PENDING" | "SENT" | "FAILED" — see src/lib/enums.ts.
  status String @default("PENDING")
  /// Why it failed, in the mail server's words. Null unless status is FAILED.
  error  String?
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([clientId])
}

/// Settings the user edits in the app rather than in a file.
///
/// A key/value table rather than a column per setting: these are configuration,
/// not data, and adding one should not mean a migration. There is exactly one
/// row per key — see src/lib/mail/settings.ts for the ones that exist.
///
/// Secrets are stored encrypted, never in the clear. The database is copied
/// wholesale by the weekly backup, so a plaintext password here would be a
/// password in every backup file.
model Setting {
  key   String @id
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
