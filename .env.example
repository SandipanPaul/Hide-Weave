DATABASE_URL="file:./prisma/dev.db"
# Password gate for the whole app. Change this before deploying anywhere.
APP_PASSWORD=""
# Secret used to sign the session cookie. Any long random string.
SESSION_SECRET=""

# Bulk mailing — OPTIONAL, and normally left blank.
#
# These are a fallback. The Mail tab has a Settings page that stores the same
# three values in the database (with the password encrypted), so a deployed
# server can be set up without touching this file. Anything saved there wins
# over what is set here.
#
# MAIL_APP_PASSWORD is normally an *app password* rather than the account
# password — Gmail: myaccount.google.com/apppasswords (needs 2-step
# verification); Yahoo: Account Security -> Generate app password.
MAIL_USER=""
MAIL_APP_PASSWORD=""
# Display name on the From header. The address is always MAIL_USER.
MAIL_FROM_NAME=""
# gmail | yahoo. Defaults to gmail.
MAIL_PROVIDER=""

# Where mail attachment bytes are kept. Defaults to an "attachments" directory
# beside the database. These are NOT included in database backups.
ATTACHMENTS_DIR=""
