# What belongs in this repository: everything needed to build and run the app
# from a clean checkout, and nothing that is generated, private, or personal.

# --------------------------------------------------------------- Generated
/node_modules
/.next/
/out/
/build
/coverage
*.tsbuildinfo

# Regenerated by `next dev` / `next build`.
next-env.d.ts

# The Prisma client, rebuilt by `prisma generate` on install (see the
# postinstall script). Machine-specific binaries — never commit it.
/src/generated

# ----------------------------------------------------------------- Private
# Secrets: APP_PASSWORD and SESSION_SECRET live here. `.env.example` is the
# committed template and is the one exception.
.env*
!.env.example

# ---------------------------------------------------------------- Your data
# The databases hold real clients, orders and payments. They belong on the
# machine that runs the app, not in a repository.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# Snapshots from `npm run db:backup`, and the copy `db:restore` sets aside.
/backups
*.db.replaced-*

# ------------------------------------------------------------ Test output
# Playwright screenshots and traces, which capture real records on screen.
/test-results
/playwright-report
/blob-report
/shots

# ------------------------------------------------------------------- Local
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
.vercel
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

Requirements.md